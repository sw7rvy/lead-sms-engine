# Normalize to LF in the repository; check out native on Windows.
* text=auto eol=lf

# Explicit for the types actually in this repo.
*.js    text eol=lf
*.gs    text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.csv   text eol=lf

# The workflow JSON is generated by tools/build.js. Collapse it in PR diffs
# and treat conflicts as a rebuild, not a hand-merge.
multi-channel-lead-sms-booking-engine.json linguist-generated=true
